API_BASE_URL=http://localhost:8099/api/frontend/v1

# NextAuth Configuration (Required)
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# SudaPass OIDC Configuration (For Production)
# If left empty, the mock login provider will be used.
SUDAPASS_CLIENT_ID=
SUDAPASS_BASE_URL=https://identity.sudapass.sd
SUDAPASS_ISSUER=https://identity.sudapass.sd
