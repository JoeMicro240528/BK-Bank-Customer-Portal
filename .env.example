# CBOS Frontend API. Must be reachable from wherever the app runs -- note that
# inside Docker, localhost is the container, not the host.
API_BASE_URL=http://172.21.1.125/api/frontend/v1

# Odoo user API key for the above. Generate in Odoo:
# Preferences > Account Security > New API Key.
# Read server-side only, by the /api/backend proxy, so it never reaches the browser.
ODOO_API_KEY=

# NextAuth Configuration (Required)
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public URL of the deployment. Required behind a reverse proxy that does not
# set X-Forwarded-Host, otherwise NextAuth builds redirect_uri from the
# container hostname and SudaPass rejects it.
AUTH_URL=https://update-cbos.nctr.sd

# SudaPass OIDC Configuration (For Production)
# If left empty, the mock login provider will be used.
# Endpoints are auto-discovered from {issuer}/.well-known/openid-configuration.
SUDAPASS_CLIENT_ID=
SUDAPASS_BASE_URL=https://sudapass.nctr.sd
SUDAPASS_ISSUER=https://sudapass.nctr.sd
